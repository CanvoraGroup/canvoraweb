<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|artisan|phpunit\.xml)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/canvora/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$)